#!/usr/bin/env bash
set -euo pipefail

# Toggle the built-in touchpad on/off.
# The state is persisted here and applied by reloading the Lua config
# (hypr/configs/common.lua reads it and sets the per-device enabled flag).
# Runtime hl.device() toggling is avoided because re-enabling a device disabled
# at runtime can leave libinput's gesture state broken: single-finger pointer
# motion stops working while multi-finger gestures keep working.
STATE_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/touchpad-toggle-state"

notify() {
  notify-send "Touchpad" "$1" >/dev/null 2>&1 || true
}

# Default state is on, matching the persistent config in common.lua.
state="$(cat "$STATE_FILE" 2>/dev/null || echo on)"

if [[ "$state" == "on" ]]; then
  new_state="off"
  message="触摸板已关闭"
else
  new_state="on"
  message="触摸板已开启"
fi

printf '%s\n' "$new_state" > "$STATE_FILE"

if ! hyprctl reload >/dev/null; then
  # Roll back so the state file never disagrees with the running config.
  printf '%s\n' "$state" > "$STATE_FILE"
  notify "切换失败"
  exit 1
fi

notify "$message"
