#!/bin/bash

set -euo pipefail

target_sink() {
    local sink

    sink="$(
        pactl list sink-inputs 2>/dev/null | awk '
            /^Sink Input #/ {
                sink = ""
                corked = "yes"
            }
            /^[[:space:]]*Sink:/ {
                sink = $2
            }
            /^[[:space:]]*Corked:/ {
                corked = $2
            }
            /^$/ {
                if (sink != "" && corked == "no") {
                    chosen = sink
                }
            }
            END {
                if (sink != "" && corked == "no") {
                    chosen = sink
                }
                if (chosen != "") {
                    print chosen
                }
            }
        '
    )"

    if [[ -n "$sink" ]]; then
        printf '%s\n' "$sink"
    else
        printf '%s\n' '@DEFAULT_AUDIO_SINK@'
    fi
}

sink="$(target_sink)"

case "${1:-}" in
    up)
        wpctl set-volume -l 1 "$sink" 5%+
        ;;
    down)
        wpctl set-volume "$sink" 5%-
        ;;
    mute)
        wpctl set-mute "$sink" toggle
        ;;
    *)
        echo "usage: volume-notify {up|down|mute}" >&2
        exit 2
        ;;
esac

volume_line="$(wpctl get-volume "$sink")"
volume="$(awk '{ printf "%d", ($2 * 100) + 0.5 }' <<<"$volume_line")"

if (( volume < 0 )); then
    volume=0
elif (( volume > 100 )); then
    volume=100
fi

if grep -q '\[MUTED\]' <<<"$volume_line"; then
    notify-send -a volume -r 91190 -u low -t 1200 \
        -h int:value:0 \
        -h string:x-canonical-private-synchronous:volume \
        "Volume" "Muted"
else
    notify-send -a volume -r 91190 -u low -t 1200 \
        -h int:value:"$volume" \
        -h string:x-canonical-private-synchronous:volume \
        "Volume" "${volume}%"
fi
